{
  "name": "obsidian-para-zk",
  "version": "0.1.0",
  "description": "Native Obsidian plugin for PARA and Zettelkasten workflows.",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "NODE_ENV=production node tools/build.mjs production",
    "version": "pnpm run build && git add -u",
    "dev": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "sync": "node tools/sync.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:vault": "node tools/smoke-test-vault.mjs",
    "typecheck": "tsc --noEmit",
    "lint:architecture": "node tools/check-architecture.mjs",
    "lint:deadcode": "knip",
    "lint": "pnpm run lint:architecture && pnpm run lint:deadcode && pnpm run typecheck"
  },
  "keywords": [
    "obsidian",
    "para",
    "zettelkasten"
  ],
  "author": "kangig94",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "knip": "^6.15.0",
    "obsidian": "^1.12.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  }
}
