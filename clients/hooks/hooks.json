{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"${CLAUDE_PLUGIN_ROOT}/hooks/para-zk-context-hook.mjs\" || exit 0; node \"${CLAUDE_PLUGIN_ROOT}/hooks/para-zk-context-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
